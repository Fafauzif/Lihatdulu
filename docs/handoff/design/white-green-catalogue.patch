diff --git a/src/stitch.css b/src/stitch.css
index 46afe17..55d9547 100644
--- a/src/stitch.css
+++ b/src/stitch.css
@@ -4413,3 +4413,142 @@ dialog::backdrop {
     max-width: 100%;
   }
 }
+
+/* Marketplace concept. Keep green on actions and selected controls. */
+.on-marketplace {
+  --canvas: #fff;
+  --paper: #fff;
+  --ink: #1b2420;
+  --muted: #515c56;
+  --line: #dfe5e0;
+  --soft: #eaf4ee;
+  --forest: #176044;
+  --forest-hover: #104832;
+  --media: #f5f6f4;
+  background: var(--canvas);
+}
+
+.market-page .market-heading {
+  margin-bottom: 12px;
+}
+
+.market-page .market-heading h1 {
+  font-size: clamp(26px, 3vw, 36px);
+  margin-top: 0;
+}
+
+.market-page .category-chips {
+  margin-bottom: 12px;
+  border-bottom: 1px solid var(--line);
+}
+
+.market-page .chip.selected {
+  background: var(--soft);
+  color: var(--forest-hover);
+  border-color: var(--forest);
+}
+
+.market-page .result-toolbar {
+  margin-bottom: 10px;
+}
+
+.market-page .mobile-filter {
+  background: var(--soft);
+  color: var(--forest-hover);
+  border-color: var(--forest);
+}
+
+.market-page .card-media {
+  aspect-ratio: 5 / 4;
+}
+
+.market-page .card-image {
+  padding: 6px;
+}
+
+.market-page .card-condition {
+  font-size: 12px;
+}
+
+@media (min-width: 900px) {
+  .market-page .market-layout {
+    grid-template-columns: 226px minmax(0, 1fr);
+    gap: clamp(16px, 2vw, 28px);
+  }
+
+  .market-page .filter-rail {
+    display: block;
+    position: sticky;
+    top: 100px;
+    padding: 14px 12px 12px;
+  }
+
+  .market-page .filter-rail .filter-heading {
+    align-items: center;
+    margin-bottom: 10px;
+  }
+
+  .market-page .filter-rail .filter-draft-help {
+    margin: 0 0 10px;
+  }
+
+  .market-page .filter-rail .filter-fields {
+    max-height: min(440px, max(140px, calc(100dvh - 440px)));
+    overflow: auto;
+    scrollbar-gutter: stable;
+    padding: 4px 8px 4px 3px;
+  }
+
+  .market-page .filter-rail fieldset {
+    margin-bottom: 12px;
+    padding-bottom: 12px;
+    border-bottom: 1px solid var(--line);
+  }
+
+  .market-page .filter-rail .filter-submit {
+    grid-template-columns: minmax(0, 1fr) auto;
+    margin-top: 10px;
+  }
+
+  .market-page .filter-rail .filter-submit .icon {
+    display: none;
+  }
+
+  .market-page .filter-rail .filter-submit > .button {
+    padding-inline: 8px;
+  }
+
+  .market-page .mobile-filter {
+    display: none;
+  }
+}
+
+@media (min-width: 900px) and (max-width: 1050px) {
+  .market-page .market-layout .product-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 700px) {
+  .market-page .market-heading > .text-link {
+    display: none;
+  }
+
+  .market-page .result-tools {
+    gap: 8px;
+  }
+
+  .market-page .category-chips {
+    flex-wrap: wrap;
+    gap: 6px;
+  }
+
+  .market-page .chip {
+    padding-inline: 9px;
+    font-size: 12px;
+  }
+
+  .market-page .quick-filter {
+    display: none;
+  }
+}
