# Placeholder values only. Copy to .env, put the real key there, and never
# commit .env. The server reads this file on start if the variable is unset.

# Live KIRI Engine key. Leave the placeholder until you are ready to spend one
# credit on a single authorized test.
KIRI_API_KEY=isi_kunci_kiri_di_sini

# Labelled simulation: no KIRI request, no credits, synthetic local result.
# KIRI_MOCK=1

# KIRI_API_BASE=https://api.kiriengine.app/api
# KIRI_JOBS_ROOT=var/kiri
# KIRI_MAX_UPLOAD_BYTES=209715200
# KIRI_UPLOAD_TIMEOUT_MS=900000
# KIRI_POLL_MIN_MS=5000
# KIRI_POLL_MAX_MS=30000
# KIRI_PORT=8787

# How the model is built. "video" uploads the clip itself; "photo" samples the
# clip into stills and submits them to KIRI's 3DGS photo endpoint, which is the
# documented route for a single object. Photo mode needs ffmpeg on PATH and
# falls back to the video upload when it is missing.
# KIRI_INPUT=video
# KIRI_FRAME_FPS=4
# KIRI_PHOTO_COUNT=120

# Automatic object masking (1, default) or off (0).
# KIRI_ISMASK=1
