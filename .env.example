# Placeholder values only. Copy to .env, put the real key there, and never
# commit .env. The server reads this file on start if the variable is unset.

# Live KIRI Engine key. Leave the placeholder until you are ready to spend one
# credit on a single authorized test.
KIRI_API_KEY=isi_kunci_kiri_di_sini

# Labelled simulation: no KIRI request, no credits, synthetic local result.
# KIRI_MOCK=1

# KIRI_API_BASE=https://api.kiriengine.app/api
# KIRI_JOBS_ROOT=var/kiri
# KIRI_MAX_UPLOAD_BYTES=209715200
# KIRI_UPLOAD_TIMEOUT_MS=900000
# KIRI_POLL_MIN_MS=5000
# KIRI_POLL_MAX_MS=30000
# KIRI_PORT=8787

# How the model is built.
#   video : upload the clip to /v1/open/3dgs/video (default)
#   photo : sample the clip into stills and send them to /v1/open/3dgs/image
#   mesh  : sample the same stills and ask /v1/open/featureless/image for a GLB.
#           This is the only profile that produced a recognisable chair from the
#           2026-11-22 footage; it returns a mesh, not splats, and the viewer
#           loads the GLB directly.
# photo and mesh need ffmpeg on PATH and fall back to the video upload when it
# is missing.
# KIRI_INPUT=video
# KIRI_FRAME_FPS=4
# KIRI_PHOTO_COUNT=120

# A mesh export is a whole room shell with a texture: the working chair arrived
# as an 85 MB GLB. Kept separate from the SPZ ceiling.
# KIRI_MAX_MODEL_BYTES=251658240

# Automatic object masking (1, default) or off (0).
# KIRI_ISMASK=1

# Experimental subject crop. A 3DGS export is the whole room; "subject" cuts a
# sphere around the point where the KIRI camera axes meet, so the viewer frames
# the furniture instead of a dot. Off by default: on the four real captures of
# 2026-11-22 the camera poses were too loose for the centre to land on the
# chair, and the crop framed a blob. Treat it as a framing experiment.
# KIRI_CROP=off
# KIRI_CROP_RADIUS=1.6
