{
  "name": "lihatdulu",
  "version": "8.0.0",
  "description": "Marketplace furnitur dengan perbandingan, inspeksi 3D, simulasi ruang, dan perjalanan video Sora.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.js",
    "test:redesign": "node scripts/verify-v8.mjs",
    "test:production": "node scripts/verify-v6-production.mjs",
    "generate:products": "node scripts/render-core-assets.mjs",
    "test:browser": "node scripts/verify-v8.mjs",
    "test:legacy": "node scripts/verify-stitch.mjs",
    "scan:serve": "node server/kiri-server.mjs",
    "scan:mock": "node scripts/kiri-mock.mjs",
    "test:kiri": "node --test tests/kiri-*.test.js tests/scan-*.test.js",
    "test:kiri:browser": "node scripts/verify-kiri-scan.mjs",
    "test:scan": "npm run test:kiri && npm run test:kiri:browser"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sparkjsdev/spark": "^2.4.0",
    "three": "^0.186.1",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.12.0",
    "@sparticuz/chromium": "^153.0.0"
  }
}
